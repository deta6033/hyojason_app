rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function guardian(deviceId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/devices/$(deviceId)/guardians/$(request.auth.uid))
        && get(/databases/$(database)/documents/devices/$(deviceId)/guardians/$(request.auth.uid)).data.enabled == true;
    }
    match /devices/{deviceId} {
      allow read: if guardian(deviceId);
      allow write: if false;
      match /guardians/{uid} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }
      match /conversations/{id} {
        allow read: if guardian(deviceId);
        allow write: if false;
      }
      // 보호자만 음량 목표값(0~100)을 설정할 수 있음.
      // 실제 앰프 출력 상한은 ESP32 펌웨어에서 별도로 강제해야 함.
      match /controls/{id} {
        allow read: if guardian(deviceId) && id == 'audio';
        allow create, update: if guardian(deviceId)
          && id == 'audio'
          && request.resource.data.keys().hasOnly(['volumePercent', 'updatedAt', 'updatedBy'])
          && request.resource.data.keys().hasAll(['volumePercent', 'updatedAt', 'updatedBy'])
          && request.resource.data.volumePercent is int
          && request.resource.data.volumePercent >= 0
          && request.resource.data.volumePercent <= 100
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedAt == request.time;
        allow delete: if false;
      }
      match /medications/{id} {
        allow read, create, update, delete: if guardian(deviceId);
      }
      match /notifications/{id} {
        allow read, create, update, delete: if guardian(deviceId);
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
